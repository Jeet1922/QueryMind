POSTGRES_DB=insightmesh
POSTGRES_USER=insightmesh
POSTGRES_PASSWORD=insightmesh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=
APP_ENV=development
LOG_LEVEL=INFO

# Groq Developer tier has limited free usage and rate limits.
# Copy to .env and add your Groq key to GROQ_API_KEY there.
INSIGHTMESH_LLM_PROVIDER=groq
INSIGHTMESH_LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

INSIGHTMESH_INTENT_DETECTION_MODEL=llama-3.1-8b-instant
INSIGHTMESH_ANSWER_GENERATION_MODEL=llama-3.3-70b-versatile
INSIGHTMESH_INSIGHT_SUMMARY_MODEL=openai/gpt-oss-20b
INSIGHTMESH_VISUALIZATION_MODEL=qwen/qwen3-32b
